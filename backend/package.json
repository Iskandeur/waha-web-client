{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js",
    "setup": "tsx src/setup/cli.ts",
    "test": "tsx --test src/guard/*.test.ts src/routes/*.test.ts src/search/*.test.ts src/setup/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
