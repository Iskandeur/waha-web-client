# Copy to deploy/.env (git-ignored) and fill in real values. Never commit the real file.

# PIN required to reach the demo (login page at /login). Pick something you can type on a
# phone keyboard. Required for this deploy path — the container ships default-open only when
# ACCESS_PIN is unset (see backend/src/access-gate.ts), which defeats the point of this file.
ACCESS_PIN=

# Signs the session cookie issued after a correct PIN. Generate one with:
#   openssl rand -hex 32
ACCESS_SESSION_SECRET=

# Local port the container is bound to on 127.0.0.1 (host side). Change only if it collides
# with another service already using it.
HOST_PORT=8788

# Docker network shared with the host's reverse-proxy/tunnel container (so it can reach this
# service by container name). Must already exist (created by that other stack).
TUNNEL_NETWORK=deploy_default
