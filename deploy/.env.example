# Copy to deploy/.env (git-ignored) and fill in real values. Never commit the real file.

# PIN required to reach the demo (login page at /login). Pick something you can type on a
# phone keyboard. Required for this deploy path — the container ships default-open only when
# ACCESS_PIN is unset (see backend/src/access-gate.ts), which defeats the point of this file.
ACCESS_PIN=

# Signs the session cookie issued after a correct PIN. Generate one with:
#   openssl rand -hex 32
ACCESS_SESSION_SECRET=

# Local port the container is bound to on 127.0.0.1 (host side). Change only if it collides
# with another service already using it.
HOST_PORT=8788

# Docker network shared with the host's reverse-proxy/tunnel container (so it can reach this
# service by container name). Must already exist (created by that other stack).
TUNNEL_NETWORK=deploy_default

# --- Demo mode vs. real connection -------------------------------------------------------
# A real (non-demo) deployment needs BOTH halves below to agree. They are separate switches
# because they act at different times, and setting only one fails *silently*:
#   * VITE_DEMO_MODE=false alone  -> real UI talking to a backend that refuses every WAHA call
#   * WAHA_REAL_CONNECTION alone  -> real, connected backend hidden behind a mock-data UI
#
# 1. Build time — baked into the frontend bundle by Vite (frontend/src/api.ts DEMO_MODE).
# Leave at "true" for the mock-data demo. Set to "false" only for a real deployment wired to
# an actual WAHA session — changing it requires rebuilding the image (`docker compose up -d
# --build`), not just restarting the container.
VITE_DEMO_MODE=true

# 2. Run time — read by the backend on boot (backend/src/config.ts, and the guard in
# backend/src/real-connection-guard.ts). All empty/false here on purpose: demo mode is the
# safe default, and an unset value reproduces the exact behaviour this codebase had before
# these flags existed. See docs/real-connection-plan.md for the phased rollout they encode.

# Where the WAHA instance lives. On the same Docker network, its container name is enough
# (e.g. http://waha:3000); WAHA_API_KEY should be a key SCOPED to the one session below
# (read+send), never the WAHA master key — the point is that this container cannot start,
# stop or log out the session it reads.
WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=

# Master switch for the real-connection guard. "true" makes the two vars below meaningful;
# anything else and the guard is a no-op that allows everything (the pre-guard behaviour).
WAHA_REAL_CONNECTION=false

# Session allowlist: must match WAHA_SESSION, or every call is refused. A typo in
# WAHA_SESSION then fails closed instead of quietly reaching a different, unintended session.
WAHA_REAL_CONNECTION_SESSION=

# Second phase of the rollout: leave "false" to run read-only (every send / presence / group
# call is blocked before it reaches WAHA), flip to "true" only once reads look right.
WAHA_REAL_CONNECTION_WRITE=false
