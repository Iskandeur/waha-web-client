# Copy this file to .env and fill in your own values. Never commit the real .env.

# Base URL of the WAHA instance the backend talks to.
# Point this at a disposable/test WAHA container, not a production number.
WAHA_BASE_URL=http://localhost:3000

# API key configured on the WAHA instance (WAHA_API_KEY env var on the WAHA side).
# Leave empty if your WAHA instance has no API key configured (test-only setups).
WAHA_API_KEY=

# WAHA session name to operate on (default WAHA session is usually "default").
WAHA_SESSION=default

# Port the backend HTTP server listens on.
PORT=8787

# Path to the `claude` CLI binary used by the AI command bar feature.
# Must be a logged-in official Claude Code binary (OAuth), never a raw API key setup.
CLAUDE_BIN=claude

# --- PIN gate for public deployments (backend/src/access-gate.ts) ---
# Set both to put a PIN wall (single-page login, signed cookie) in front of every route.
# Leave ACCESS_PIN empty (default) to disable the gate entirely — fine for local/self-hosted use
# where you're the only one who can reach the port. Never commit real values.
# ACCESS_PIN=
# ACCESS_SESSION_SECRET=

# --- Anti-detection guard (backend/src/guard/) ---
# All of these have conservative built-in defaults; uncomment to override. See README
# "Anti-detection guard" for what each one does and why the defaults are that low.
# GUARD_ENABLED=true
# GUARD_CHAT_MSGS_PER_MIN=3
# GUARD_CHAT_MSGS_PER_HOUR=20
# GUARD_GLOBAL_MSGS_PER_MIN=8
# GUARD_GLOBAL_MSGS_PER_HOUR=80
# GUARD_JITTER_MIN_MS=800
# GUARD_JITTER_MAX_MS=4000
# GUARD_TYPING_MS_PER_CHAR=45
# GUARD_TYPING_MIN_MS=900
# GUARD_TYPING_MAX_MS=8000
# GUARD_BURST_WINDOW_MS=60000
# GUARD_BURST_CHAT_THRESHOLD=4
# GUARD_DUP_WINDOW_MS=600000
# GUARD_WARMUP_MS=1800000
# GUARD_WARMUP_DIVISOR=3
# GUARD_BREAKER_ERR_THRESHOLD=3
# GUARD_BREAKER_WINDOW_MS=300000
# GUARD_BREAKER_COOLDOWN_MS=900000
# GUARD_AUDIT_LOG_MAX=500

# Group-action guard (backend/src/guard/group-guard.ts) — same idea as the send guard above,
# but for bulk group-membership mutations (add/remove/promote/demote participants).
# GUARD_GROUP_MAX_PARTICIPANTS_PER_CALL=20
# GUARD_GROUP_MAX_PER_GROUP_PER_MIN=2
# GUARD_GROUP_MAX_GLOBAL_PER_MIN=5
# GUARD_GROUP_MAX_GLOBAL_PER_HOUR=30

# --- Real-connection guard (backend/src/real-connection-guard.ts) ---
# Gates pointing this backend at a real, valued WAHA session instead of a disposable/test one.
# All three default OFF — leave unset for normal use (disposable WAHA, public demo). See
# docs/real-connection-plan.md before ever setting these against a production session.
# WAHA_REAL_CONNECTION=true
# WAHA_REAL_CONNECTION_SESSION=
# WAHA_REAL_CONNECTION_WRITE=true
