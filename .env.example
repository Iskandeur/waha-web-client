# Copy this file to .env and fill in your own values. Never commit the real .env.

# Base URL of the WAHA instance the backend talks to.
# Point this at a disposable/test WAHA container, not a production number.
WAHA_BASE_URL=http://localhost:3000

# API key configured on the WAHA instance (WAHA_API_KEY env var on the WAHA side).
# Leave empty if your WAHA instance has no API key configured (test-only setups).
WAHA_API_KEY=

# WAHA session name to operate on (default WAHA session is usually "default").
WAHA_SESSION=default

# Port the backend HTTP server listens on.
PORT=8787

# Path to the `claude` CLI binary used by the AI command bar feature.
# Must be a logged-in official Claude Code binary (OAuth), never a raw API key setup.
CLAUDE_BIN=claude
